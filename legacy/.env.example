# Copy this file to .env and fill in values from Supabase:
# Project Settings → API
#
# Use the publishable key only (sb_publishable_... or the legacy anon JWT).
# Never put sb_secret_ / service_role in this file — the Vite app is public.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key
